### Gitignore file ###

# Ignore virtual environment and cache files
.venv/
__pycache__/
*.egg-info/
.vscode/

# MacOS specific files
.DS_Store

# Gurobi logs
gurobi.log

# Synthetic Data
*/SyntheticPortfolioData/*

# Data Storage — generated caches and binary artefacts
*.csv
*.npz
*.pkl
src/dflintdpy/scripts/BipartiteMatchingData/*
store_data/

# Text files
*.txt

# Generated Figures
figures/*
*.png

# Generated results
results/

# Ad-hoc scripts and private notes
diagnostics.py
Data_Collection.md
results_bppo.md
test/
tools/

# Codex
.codex/

# Test launcher
test_launcher.py

# Real-world graph topology files (override the *.csv and *.txt rules above)
!real_world_spni_data/
!real_world_spni_data/**/*.csv
!real_world_spni_data/**/*.txt
!real_world_spni_data/**/*.tntp
